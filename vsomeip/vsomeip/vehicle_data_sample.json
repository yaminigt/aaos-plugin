{
  "unicast": "192.168.98.1",
  "routing": "vehicle_data_sample",
  "applications": [
    {
      "name": "vehicle_data_sample",
      "id": "0x2100"
    }
  ],
  "services": [
    {
      "service": "0x2100",
      "instance": "0x1000",
      "reliable": {
        "port": "2100",
