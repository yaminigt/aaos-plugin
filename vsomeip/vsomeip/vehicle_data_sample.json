          "is_field": false,
          "is_reliable": true,
          "update-cycle": "1000"
        }
      ],
      "eventgroups": [
        {
          "eventgroup": "0x9210",
          "events": [
            "0x8210"
          ]
        },
        {
          "eventgroup": "0x9211",
          "events": [
            "0x8211"
          ]
        }
      ]
    }
  ],
  "logging": {
    "level": "trace",
    "console": true,
    "file": {
      "enable": true,
